{
  "@@locale": "en",
  "appTitle": "Turnover!",
  "@appTitle": {
    "description": "Nombre visible de la aplicación, igual en los dos idiomas"
  },
  "appTagline": "Timer for Blood Bowl matches",
  "@appTagline": {
    "description": "Subtítulo de la aplicación, fijado en el ADR-0004"
  },
  "startHint": "Tap to start",
  "@startHint": {
    "description": "Invitación de cada mitad antes de empezar el partido"
  },
  "renameHintInline": "Hold to change this name",
  "@renameHintInline": {
    "description": "Frase entera del gesto de renombrar, la que leen los lectores de pantalla"
  },
  "renameHintShort": "Hold to rename",
  "@renameHintShort": {
    "description": "Pista al lado del nombre, solo antes de empezar, de que una pulsación larga lo cambia"
  },
  "passTurn": "End my turn",
  "@passTurn": {
    "description": "Etiqueta de accesibilidad del control central"
  },
  "pause": "Pause",
  "@pause": {
    "description": "Etiqueta de accesibilidad del control de pausa"
  },
  "resume": "Resume",
  "@resume": {
    "description": "Etiqueta de accesibilidad del control de pausa, ya pausado"
  },
  "paused": "Paused",
  "@paused": {
    "description": "Fila de estado del velo de pausa: por qué el reloj no corre. La de por defecto, pausado a mano"
  },
  "secondHalf": "Second half",
  "@secondHalf": {
    "description": "Fila de estado del velo en el parón del cambio de parte, que es un despliegue: dice la parte que va a empezar, que es lo que explica el salto del 8 al 9 que se lee por detrás"
  },
  "continueHint": "Tap anywhere to continue",
  "@continueHint": {
    "description": "Llamada a la acción del velo de pausa, siempre debajo del estado. El verbo es el de startHint: 'Pulsa' y 'Toca' eran dos formas del mismo dedo"
  },
  "kickOffEvent": "Kick-off event",
  "@kickOffEvent": {
    "description": "Encabeza el botón de Time-Out en el velo de pausa. Dice de qué tabla sale el botón: sin él, 'Time-Out' se lee como pausar, que es lo que el velo ya es"
  },
  "timeOut": "Time-Out",
  "@timeOut": {
    "description": "Botón del velo de pausa que declara un Time-Out. Es el nombre del reglamento y no se traduce (ADR-0010)"
  },
  "timeOutTitle": "Apply Time-Out?",
  "@timeOutTitle": {
    "description": "Título del diálogo que confirma el Time-Out declarado desde el velo"
  },
  "timeOutForwardBody": "Both teams will move one turn forward. This cannot be undone.",
  "@timeOutForwardBody": {
    "description": "Consecuencia del Time-Out cuando el turno de tablero del pateador no es 6, 7 ni 8, que es cuando ambos avanzan (ADR-0010)"
  },
  "timeOutBackBody": "Both teams will move one turn back. This cannot be undone.",
  "@timeOutBackBody": {
    "description": "Consecuencia del Time-Out cuando el turno de tablero del pateador es 6, 7 u 8, que es cuando ambos retroceden (ADR-0010)"
  },
  "timeOutConfirm": "Confirm",
  "@timeOutConfirm": {
    "description": "Botón que confirma el Time-Out en el diálogo"
  },
  "turnCount": "Turn {number} of {total}",
  "@turnCount": {
    "description": "Lo que un lector de pantalla dice de la cuenta de turnos de un jugador. El número es el corrido, de 1 a 16 (ADR-0010)",
    "placeholders": {
      "number": { "type": "int" },
      "total": { "type": "int" }
    }
  },
  "matchReportHeading": "Full time",
  "@matchReportHeading": {
    "description": "Encabeza el acta y dice que el partido ha terminado"
  },
  "matchReportPlayed": "{name} played {time}",
  "@matchReportPlayed": {
    "description": "Lo que un lector de pantalla dice del tiempo jugado por un jugador en el acta",
    "placeholders": {
      "name": { "type": "String" },
      "time": { "type": "String" }
    }
  },
  "matchReportPlayTime": "Play time",
  "@matchReportPlayTime": {
    "description": "Rotula la cifra que encabeza el acta: lo que han jugado los dos sumado, sin las pausas"
  },
  "matchReportTotalTime": "Total {time}",
  "@matchReportTotalTime": {
    "description": "Debajo de la cifra grande del acta: lo que ha durado el partido con las pausas dentro. Lo parado es la diferencia entre este y el tiempo de juego",
    "placeholders": {
      "time": { "type": "String" }
    }
  },
  "matchReportPerTurn": "Time per turn",
  "@matchReportPerTurn": {
    "description": "Encabeza la gráfica del acta, que dibuja lo que duró cada turno de cada jugador"
  },
  "matchReportPeak": "{name}: longest turn {time}, turn {number}",
  "@matchReportPeak": {
    "description": "Lo que un lector de pantalla dice de la línea de un jugador en la gráfica del acta. Es el único punto que la gráfica señala, porque señalarlos todos sería un número en cada dato",
    "placeholders": {
      "name": { "type": "String" },
      "time": { "type": "String" },
      "number": { "type": "int" }
    }
  },
  "matchReportAverage": "{name}: average turn {time}",
  "@matchReportAverage": {
    "description": "Lo que un lector de pantalla dice de la línea discontinua de un jugador en la gráfica del acta, que marca lo que le dura un turno de media",
    "placeholders": {
      "name": { "type": "String" },
      "time": { "type": "String" }
    }
  },
  "matchReportShare": "Share",
  "@matchReportShare": {
    "description": "Botón del acta que hace una foto de ella y la saca por el menú de compartir del sistema"
  },
  "matchReportShareText": "Turnover! match report: {one} vs {two}",
  "@matchReportShareText": {
    "description": "Lo que acompaña a la imagen del acta al compartirla, donde el destino admita texto. Nombra a los dos jugadores, que es lo que distingue un acta de la siguiente en una bandeja de entrada: la imagen no se lee hasta que se abre, y el texto sí",
    "placeholders": {
      "one": { "type": "String" },
      "two": { "type": "String" }
    }
  },
  "matchReportEnd": "End match",
  "@matchReportEnd": {
    "description": "El único botón del acta, que devuelve la aplicación a antes de empezar"
  },
